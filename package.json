{
  "name": "suppstack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "source:shopify": "node src/scripts/sourceShopifyProducts.mjs",
    "source:shopify:fast": "node src/scripts/sourceShopifyProducts.mjs --fast",
    "source:shopify:merge": "node src/scripts/sourceShopifyProducts.mjs --fast --merge-existing",
    "source:shopify:cache-only": "node src/scripts/sourceShopifyProducts.mjs --cache-only --no-write",
    "verify:shopify-catalog": "ts-node src/scripts/verifyShopifyCatalog.ts",
    "report:catalog-coverage": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\",\"esModuleInterop\":true}' ts-node -r tsconfig-paths/register src/scripts/reportCatalogCoverage.ts",
    "check:catalog": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\",\"esModuleInterop\":true}' ts-node -r tsconfig-paths/register src/scripts/checkCatalogIntegrity.ts",
    "check:ingredient-intake": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\",\"esModuleInterop\":true}' ts-node -r tsconfig-paths/register src/scripts/checkIngredientIntake.ts",
    "app-store:assets": "node src/scripts/generateAppStoreAssets.mjs",
    "ios:sync": "node src/scripts/syncIos.mjs",
    "ios:open": "cap open ios",
    "ios:assets": "capacitor-assets generate --ios",
    "postinstall": "patch-package",
    "ios:run": "cap run ios --no-sync --target $(xcrun simctl list devices booted | grep -oE '[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}' | head -1)",
    "ios:logs": "xcrun simctl spawn booted log stream --level=debug --style=compact --predicate 'process == \"App\"'"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@supabase/supabase-js": "^2.111.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
