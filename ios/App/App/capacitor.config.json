{
	"appId": "com.suppstack.app",
	"appName": "SuppStack",
	"webDir": "native/shell",
	"server": {
		"url": "https://suppstack.vercel.app",
		"allowNavigation": [
			"suppstack.vercel.app",
			"*.supabase.co"
		],
		"errorPath": "index.html"
	},
	"ios": {
		"contentInset": "never",
		"backgroundColor": "#ffffff"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1500,
			"launchAutoHide": true,
			"backgroundColor": "#171717",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "LIGHT"
		}
	},
	"packageClassList": [
		"AppPlugin",
		"CAPBrowserPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
