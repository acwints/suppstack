{
	"appId": "app.suppstack",
	"appName": "SuppStack AI",
	"webDir": "native/shell",
	"server": {
		"url": "https://www.suppstack.app",
		"allowNavigation": [
			"www.suppstack.app",
			"suppstack.app",
			"suppstack.vercel.app",
			"*.supabase.co"
		],
		"errorPath": "index.html"
	},
	"ios": {
		"contentInset": "never",
		"backgroundColor": "#ffffff"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1500,
			"launchAutoHide": true,
			"backgroundColor": "#171717",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "LIGHT"
		}
	},
	"packageClassList": [
		"AppPlugin",
		"CAPBrowserPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin",
		"PurchasesPlugin",
		"SuppStackHealthPlugin",
		"SuppStackAppleSignInPlugin"
	]
}
